NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Replace with the canonical public HTTPS origin before deploying.
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Prisma 7 runtime PostgreSQL adapter; use a pooled connection when available.
DATABASE_URL=postgresql://username:password@ep-example-pooler.us-east-1.aws.neon.tech/ai_trip_planner?sslmode=require&pgbouncer=true

# Prisma 7 CLI datasource in prisma.config.ts; use the direct connection.
DIRECT_URL=postgresql://username:password@ep-example.us-east-1.aws.neon.tech/ai_trip_planner?sslmode=require

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
# Optional: enables exact-name candidate verification via Google Places API (New).
GOOGLE_MAPS_API_KEY=
# Optional OpenRouter account pricing, USD per million tokens; cost stays null if omitted.
OPENROUTER_INPUT_COST_PER_MILLION=
OPENROUTER_OUTPUT_COST_PER_MILLION=
ARCJET_KEY=ajkey_your_arcjet_key
ADMIN_USERS=admin@example.com
CRON_SECRET=replace_with_a_long_random_secret
