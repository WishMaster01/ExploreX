{
  "name": "ai_trip_planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "prisma generate",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma generate && node scripts/init-db.js",
    "db:seed-content": "prisma generate && node --experimental-strip-types scripts/seed-city-guides.mjs",
    "db:seed-cities": "npm run db:seed-content",
    "data:validate": "node --experimental-strip-types scripts/import-india-catalog.mjs",
    "data:import:jaipur": "node --experimental-strip-types scripts/import-india-catalog.mjs --apply",
    "db:studio": "prisma studio",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@arcjet/next": "^1.5.0",
    "@clerk/nextjs": "^6.30.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tabler/icons-react": "^3.34.1",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "eslint": "^9.39.4",
    "lucide-react": "^0.539.0",
    "motion": "^12.23.12",
    "next": "^16.2.9",
    "openai": "^5.12.2",
    "pg": "^8.23.1",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
