// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER  @map("user")
  ADMIN @map("admin")

  @@map("user_role")
}

enum ReminderType {
  TRIP    @map("trip")
  PACKING @map("packing")
  BOOKING @map("booking")

  @@map("reminder_type")
}

enum ReminderStatus {
  SCHEDULED @map("scheduled")
  CANCELLED @map("cancelled")
  COMPLETED @map("completed")

  @@map("reminder_status")
}

enum SourceType {
  AI_GENERATED
  PROVIDER
  CURATED

  @@map("source_type")
}

enum KnowledgeVerificationStatus {
  VERIFIED
  PROVIDER_SOURCED
  COMMUNITY_SUBMITTED
  ESTIMATED
  AI_GENERATED
  STALE
  UNAVAILABLE
  REJECTED
  CURATED
  NEEDS_REVIEW
}

enum KnowledgeVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id           String   @id @default(cuid())
  clerkUserId  String?  @unique
  email        String   @unique
  name         String
  imageUrl     String?
  subscription String   @default("free")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  trips           Trip[]
  reminders       Reminder[]
  analyticsEvents AnalyticsEvent[]
  savedCities     SavedCity[]
  privateKnowledgeDocuments KnowledgeDocument[]
  agentRuns AgentRun[]

  @@map("users")
}

model Trip {
  id                 String   @id @default(cuid())
  budget             String?
  destination        String
  duration           String?
  groupSize          String?
  origin             String?
  plan               Json?
  planHash           String?
  budgetAmount       Int?
  budgetAmountMinor  Int?
  budgetCurrencyCode String?
  durationDays       Int?
  isFavorite         Boolean  @default(false)
  lastViewedAt       DateTime @default(now()) @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotels         TripHotel[]
  days           TripDay[]
  itineraryItems ItineraryItem[]
  reminders      Reminder[]

  @@unique([userId, planHash])
  // Supports the composite reminder FK that enforces matching trip ownership.
  @@unique([id, userId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isFavorite, createdAt(sort: Desc)])
  @@index([userId, budgetAmount])
  @@index([userId, durationDays])
  @@index([userId, destination])
  @@map("trips")
}

model Reminder {
  id             String         @id @default(cuid())
  type           ReminderType   @default(TRIP)
  message        String
  remindAt       DateTime       @db.Timestamptz(3)
  timeZone       String         @default("UTC")
  status         ReminderStatus @default(SCHEDULED)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  idempotencyKey String?        @db.VarChar(128)

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId String?
  trip   Trip?   @relation(fields: [tripId, userId], references: [id, userId], onDelete: Cascade, map: "reminders_tripId_userId_fkey")

  @@unique([userId, idempotencyKey])
  @@index([userId, status, remindAt])
  @@index([status, remindAt, id])
  @@map("reminders")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String
  destination String?
  success     Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([destination, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

// Agent traces retain operational metadata only; conversation and prompt text are never stored.
model AgentRun {
  id                 String      @id @default(cuid())
  requestId          String      @unique
  schemaVersion      String
  workflowVersion    String
  promptVersion      String
  status             String
  provider           String?
  model              String?
  startedAt          DateTime    @default(now()) @db.Timestamptz(3)
  finishedAt         DateTime?   @db.Timestamptz(3)
  latencyMs          Int?
  retryCount         Int         @default(0)
  inputTokens        Int?
  outputTokens       Int?
  estimatedCostUsd   Float?
  failureCode        String?
  trace              String[]    @default([])
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks              AgentTask[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@map("agent_runs")
}

model AgentTask {
  id               String    @id @default(cuid())
  runId            String
  taskName         String
  attempt          Int       @default(1)
  status           String
  startedAt        DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt       DateTime? @db.Timestamptz(3)
  latencyMs        Int?
  retryCount       Int       @default(0)
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  failureCode      String?
  run              AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, taskName, attempt])
  @@index([runId, startedAt])
  @@map("agent_tasks")
}

model CityGuide {
  slug      String   @id
  name      String
  country   String
  region    String
  content   Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  savedBy SavedCity[]

  @@index([region, name])
  @@map("city_guides")
}

model SavedCity {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  userId    String
  citySlug  String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      CityGuide @relation(fields: [citySlug], references: [slug], onDelete: Cascade)

  @@unique([userId, citySlug])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_cities")
}

model SiteDataset {
  key       String   @id
  content   Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_datasets")
}

model KnowledgeSource {
  id              String   @id
  name            String
  url             String
  owner           String
  licenseStatus   String
  license         String
  termsUrl        String?
  attribution     String
  storagePolicy   String   @db.Text
  dataTypes       String[] @default([])
  lastCheckedAt   DateTime @db.Date
  ingestionAllowed Boolean @default(false)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  documents KnowledgeDocument[]
  failures  KnowledgeIngestionFailure[]

  @@map("knowledge_sources")
}

model KnowledgeDocument {
  id                  String                       @id @default(cuid())
  sourceDocumentId    String
  version             Int
  isCurrent           Boolean                      @default(true)
  isActive            Boolean                      @default(true)
  title               String
  content             String                       @db.Text
  contentHash         String
  recordHash          String
  destinationId       String?
  latitude            Float?
  longitude           Float?
  categoryIds         String[]                     @default([])
  factTypes           String[]                     @default([])
  language            String                       @default("en")
  verificationStatus  KnowledgeVerificationStatus
  visibility          KnowledgeVisibility          @default(PUBLIC)
  sourceUrl           String
  attribution         String
  license             String                       @db.Text
  storagePolicy       String                       @db.Text
  lastVerifiedAt      DateTime?                    @db.Date
  ingestedAt          DateTime                     @default(now()) @db.Timestamptz(3)
  sourceId            String
  ownerId             String?
  source              KnowledgeSource              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  owner               User?                        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks              KnowledgeChunk[]

  @@unique([sourceId, sourceDocumentId, version])
  @@index([sourceId, sourceDocumentId, isCurrent, isActive])
  @@index([destinationId, verificationStatus, visibility, isCurrent, isActive])
  @@index([ownerId, visibility, isCurrent, isActive])
  @@index([latitude, longitude])
  @@index([categoryIds], type: Gin)
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id                String            @id @default(cuid())
  documentId        String
  chunkIndex        Int
  content           String            @db.Text
  contentHash       String
  embedding         Unsupported("vector(1536)")?
  embeddingModel    String?
  embeddingTokens   Int?
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  document          KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("knowledge_chunks")
}

model KnowledgeIngestionFailure {
  id           String          @id @default(cuid())
  sourceId     String?
  sourceDocId  String?
  contentHash  String?
  stage        String
  errorCode    String
  details      String          @db.VarChar(500)
  occurredAt   DateTime        @default(now()) @db.Timestamptz(3)
  resolvedAt   DateTime?       @db.Timestamptz(3)
  source       KnowledgeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId, occurredAt])
  @@index([resolvedAt, occurredAt])
  @@map("knowledge_ingestion_failures")
}

model TripHotel {
  id                  String     @id @default(cuid())
  name                String
  address             String?
  imageUrl            String?
  latitude            Float?
  longitude           Float?
  description         String?
  pricePerNight       String
  priceAmountMinor    Int?
  currencyCode        String?
  rating              Float
  recommendationScore Float?
  sourceType          SourceType @default(AI_GENERATED)
  amenities           String[]   @default([])
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)

  // Relations
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("hotels")
}

model ItineraryItem {
  id         String   @id @default(cuid())
  day        Int
  activities String[] @default([])
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  // Relations
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, day])
  @@map("itinerary_items")
}

// `Trip.plan` retains the complete validated AI plan for provenance and fields
// that have not been normalized. Day and activity records are queryable entities.
model TripDay {
  id         String         @id @default(cuid())
  dayNumber  Int
  title      String
  bestTime   String?
  tripId     String
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities TripActivity[]

  @@unique([tripId, dayNumber])
  @@map("trip_days")
}

model TripActivity {
  id                     String     @id @default(cuid())
  position               Int
  placeName              String?
  details                String?
  imageUrl               String?
  latitude               Float?
  longitude              Float?
  address                String?
  ticketPricing          String?
  estimatedCostMinor     Int?
  currencyCode           String?
  travelTime             String?
  bestTime               String?
  openingTime            String?
  closingTime            String?
  visitDurationMinutes   Int?
  scheduledStart         String?
  scheduledEnd           String?
  distanceFromPreviousKm Float?
  sourceType             SourceType @default(AI_GENERATED)
  dayId                  String
  day                    TripDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, position])
  @@map("trip_activities")
}
